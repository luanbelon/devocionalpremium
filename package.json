{
  "name": "devocional-premium",
  "version": "1.0.0",
  "private": true,
  "description": "Gerador de devocionais KDP (versão premium): PDF colorido, PDF preto e branco e EPUB a partir de um JSON.",
  "scripts": {
    "assets": "node scripts/embed-assets.mjs",
    "predev": "npm run assets",
    "dev": "next dev",
    "prebuild": "npm run assets",
    "build": "next build",
    "start": "next start",
    "typecheck": "npm run assets && tsc --noEmit"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@sparticuz/chromium": "^143.0.4",
    "jszip": "^3.10.2",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.43.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
